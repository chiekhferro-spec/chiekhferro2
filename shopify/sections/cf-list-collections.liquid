{% comment %} sections/cf-list-collections.liquid — Collections index {% endcomment %}
<div class="mx-auto max-w-[1400px] px-4 py-8">
  <h1 class="text-2xl font-black text-ink-main mb-6">المجموعات</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {% for collection in collections %}
      <a href="{{ collection.url }}" class="group block bg-bg-surface rounded-industrial-lg border border-steel-500/60 overflow-hidden hover:border-accent/50 transition-all">
        <div class="aspect-[4/3] overflow-hidden bg-steel-700">
          {% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500">{% endif %}
        </div>
        <div class="p-4">
          <h2 class="text-lg font-bold text-ink-main group-hover:text-accent">{{ collection.title }}</h2>
          <span class="text-xs text-ink-faint">{{ collection.products_count }} منتج</span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
{% schema %}{ "name": "CF List Collections", "settings": [] }{% endschema %}
