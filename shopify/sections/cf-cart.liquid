{% comment %}
  sections/cf-cart.liquid
  CHIEKH FERRO — Cart page section (full page cart, not drawer).
{% endcomment %}
<div class="mx-auto max-w-[1000px] px-4 py-8">
  <h1 class="text-2xl font-black text-ink-main mb-6">سلة المشتريات</h1>

  {% if cart.item_count == 0 %}
    <div class="text-center py-20 bg-bg-surface rounded-industrial-lg border border-steel-500/60">
      <p class="text-lg font-bold text-ink-main">سلتك فارغة</p>
      <p class="mt-1 text-sm text-ink-muted">ابدأ التسوق واكتشف معداتنا الصناعية.</p>
      <a href="/collections/all" class="mt-5 h-10 px-5 inline-flex items-center rounded-industrial bg-accent text-bg-primary text-sm font-bold hover:bg-accent-yellow transition-colors">
        تصفح المنتجات
      </a>
    </div>
  {% else %}
    <form action="/cart" method="post" class="space-y-4">
      {% for item in cart.items %}
        <div class="flex items-center gap-4 bg-bg-surface rounded-industrial-lg border border-steel-500/60 p-4">
          {% if item.image %}
            <a href="{{ item.url }}" class="shrink-0">
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" class="h-20 w-20 object-cover rounded-industrial">
            </a>
          {% endif %}
          <div class="flex-1 min-w-0">
            <a href="{{ item.url }}" class="text-sm font-bold text-ink-main hover:text-accent transition-colors line-clamp-1">{{ item.product.title }}</a>
            {% if item.variant.title != 'Default Title' %}
              <p class="text-xs text-ink-faint mt-0.5">{{ item.variant.title }}</p>
            {% endif %}
            <p class="text-xs text-ink-faint mt-0.5">SKU: {{ item.sku | default: '-' }}</p>
          </div>
          <div class="flex items-center gap-1 rounded-industrial border border-steel-400 bg-bg-primary px-1">
            <button type="button" onclick="this.nextElement.stepDown()" class="h-8 w-8 text-ink-muted hover:text-accent">-</button>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-10 text-center text-sm font-bold text-ink-main bg-transparent">
            <button type="button" onclick="this.previousElement.stepUp()" class="h-8 w-8 text-ink-muted hover:text-accent">+</button>
          </div>
          <div class="text-left shrink-0">
            <div class="text-sm font-black text-ink-main">{{ item.final_line_price | money }}</div>
            <div class="text-xs text-ink-faint">{{ item.final_price | money }} / قطعة</div>
          </div>
          <a href="/cart/change?line={{ forloop.index }}&quantity=0"
             class="shrink-0 text-ink-faint hover:text-danger transition-colors"
             aria-label="حذف">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </a>
        </div>
      {% endfor %}

      <div class="flex items-center justify-between pt-4 border-t border-steel-500/60">
        <span class="text-lg font-bold text-ink-main">الإجمالي</span>
        <span class="text-2xl font-black text-accent">{{ cart.total_price | money }}</span>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button type="submit" name="update" class="h-11 px-6 rounded-industrial bg-bg-surface border border-steel-500 text-ink-main font-bold hover:border-accent/50 transition-colors">
          تحديث السلة
        </button>
        <button type="submit" name="checkout" class="flex-1 h-11 rounded-industrial bg-accent text-bg-primary font-bold hover:bg-accent-yellow transition-colors">
          إتمام الطلب
        </button>
      </div>
    </form>
  {% endif %}
</div>

{% schema %}
{
  "name": "CF Cart",
  "settings": []
}
{% endschema %}
