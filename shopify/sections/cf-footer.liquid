{% comment %}
  sections/cf-footer.liquid
  CHIEKH FERRO — Global footer with contact info + nav.
{% endcomment %}
<footer class="bg-bg-elevated border-t border-steel-500/60 mt-16">
  <div class="mx-auto max-w-[1400px] px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {% comment %} Brand {% endcomment %}
      <div class="md:col-span-2">
        <span class="text-2xl font-black text-ink-main tracking-tight">
          CHIEKH <span class="text-accent">FERRO</span>
        </span>
        <p class="mt-3 text-sm text-ink-muted max-w-sm leading-relaxed">
          علامتكم الموثوقة في المعدات الصناعية والآلات الثقيلة. معدات أصلية بضمان رسمي للمحترفين والمقاولات.
        </p>
      </div>

      {% comment %} Quick links {% endcomment %}
      <div>
        <h3 class="text-sm font-bold text-ink-main mb-3">روابط سريعة</h3>
        <ul class="space-y-2">
          {% for link in linklists.footer.links limit: 6 %}
            <li><a href="{{ link.url }}" class="text-sm text-ink-muted hover:text-accent transition-colors">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      {% comment %} Contact {% endcomment %}
      <div>
        <h3 class="text-sm font-bold text-ink-main mb-3">تواصل معنا</h3>
        <ul class="space-y-2 text-sm text-ink-muted">
          {% if settings.footer_address != blank %}
            <li class="flex items-start gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent mt-0.5 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {{ settings.footer_address }}
            </li>
          {% endif %}
          {% if settings.footer_phone != blank %}
            <li class="flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {{ settings.footer_phone }}
            </li>
          {% endif %}
          {% if settings.footer_email != blank %}
            <li class="flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
              {{ settings.footer_email }}
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-steel-500/40 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-ink-faint">© {{ 'now' | date: '%Y' }} CHIEKH FERRO. جميع الحقوق محفوظة.</p>
      <p class="text-xs text-ink-faint">ضمان رسمي · توصيل لكل ولايات الوطن · دفع عند الاستلام</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "CF Footer",
  "settings": []
}
{% endschema %}
