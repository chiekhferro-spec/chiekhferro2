{% comment %} sections/cf-blog.liquid — Blog listing {% endcomment %}
<div class="mx-auto max-w-[800px] px-4 py-12">
  <h1 class="text-3xl font-black text-ink-main mb-6">{{ blog.title }}</h1>
  <div class="space-y-6">
    {% for article in blog.articles %}
      <a href="{{ article.url }}" class="block bg-bg-surface rounded-industrial-lg border border-steel-500/60 p-5 hover:border-accent/50 transition-all">
        <h2 class="text-lg font-bold text-ink-main">{{ article.title }}</h2>
        {% if article.excerpt != blank %}<p class="mt-2 text-sm text-ink-muted line-clamp-2">{{ article.excerpt | strip_html }}</p>{% endif %}
        <span class="mt-3 block text-xs text-accent">{{ article.published_at | date: '%d %B %Y' }}</span>
      </a>
    {% endfor %}
  </div>
</div>
{% schema %}{ "name": "CF Blog", "settings": [] }{% endschema %}
