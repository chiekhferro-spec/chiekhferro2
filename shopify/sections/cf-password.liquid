{% comment %} sections/cf-password.liquid — Password page {% endcomment %}
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="text-center max-w-md">
    <span class="text-2xl font-black text-ink-main">CHIEKH <span class="text-accent">FERRO</span></span>
    <h1 class="mt-6 text-xl font-bold text-ink-main">{{ 'general.password_page.opening_soon' | t }}</h1>
    {% form 'storefront_password' %}
      <input type="password" name="password" placeholder="كلمة المرور" class="mt-4 w-full h-11 rounded-industrial bg-bg-surface border border-steel-500 px-4 text-sm text-ink-main focus-industrial">
      <button type="submit" class="mt-3 w-full h-11 rounded-industrial bg-accent text-bg-primary font-bold hover:bg-accent-yellow transition-colors">دخول</button>
    {% endform %}
  </div>
</div>
{% schema %}{ "name": "CF Password", "settings": [] }{% endschema %}
